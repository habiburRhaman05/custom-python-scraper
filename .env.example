# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres (VPS / production)
DATABASE_URL=postgresql+psycopg://scraper:CHANGE_ME@localhost:5432/maisondubai
# Local dev without a Postgres server:
# DATABASE_URL=sqlite:///./maisondubai.db

# ---------------------------------------------------------------------------
# Admin auth — required by POST /api/admin/scrape and the other admin routes.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
ADMIN_API_KEY=CHANGE_ME_generate_a_long_random_value

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Comma-separated frontend origins allowed to call the public endpoints.
# Use * only for local development.
CORS_ORIGINS=http://localhost:3000
API_TITLE=maisondubai data API

# ---------------------------------------------------------------------------
# Scrape tuning — defaults are deliberately polite (~2,650 pages per full run)
# ---------------------------------------------------------------------------
SCRAPE_OUTPUT_DIR=output
SCRAPE_CACHE_DIR=.cache_maisondubai
SCRAPE_WORKERS=6
SCRAPE_DELAY=0.3
# Revalidate cached pages with ETag/If-None-Match instead of blind re-download.
SCRAPE_REVALIDATE=true

# ---------------------------------------------------------------------------
# Safety rails — a run that trips any of these is marked `aborted` and the
# database is left untouched. This is what catches maisondubai.com changing
# their HTML out from under the parsers.
# ---------------------------------------------------------------------------
# Abort if the project count falls below this fraction of the last good run.
GUARD_MIN_COUNT_RATIO=0.8
# Abort if price coverage drops by more than this many percentage points.
GUARD_MAX_COVERAGE_DROP=30.0
# Abort if a single run would delist more than this fraction of known records.
GUARD_MAX_DELIST_RATIO=0.2
# Set false to force a write even when a rail trips (not recommended).
GUARD_ENABLED=true
